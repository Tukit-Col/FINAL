function crearFormularioTukit() {
  var f = FormApp.create("TUKIT: prueba con acudientes (ronda 2)");
  f.setCollectEmail(false); f.setProgressBar(true);
  f.setDescription("Gracias por ayudarnos a evaluar TUKIT, una herramienta para armar la lista de útiles escolares. El formulario tiene cuatro partes: primero el consentimiento, luego unas preguntas sobre su última compra de útiles, después las preguntas sobre la prueba que acaba de hacer y, al final, su opinión. Evaluamos el sistema, no a usted, así que no hay respuestas correctas ni incorrectas.");
  f.addSectionHeaderItem().setHelpText("Esta sesión hace parte del trabajo de grado de Ingeniería de Sistemas de la Pontificia Universidad Javeriana. En la sesión usted usa TUKIT con una cuenta y datos de prueba, dice en voz alta lo que piensa y responde este formulario. Sus respuestas se usan solo para el trabajo de grado y para mejorar el prototipo; no se comparten con el colegio, con tiendas ni con terceros, y los resultados se publican en conjunto, sin nombres. No pedimos datos de su hijo o hija, y su hijo o hija no participa. El pago dentro de la prueba es simulado, de modo que no debe usar su tarjeta real. Según la Ley 1581 de 2012 y el Decreto 1377 de 2013, usted puede conocer, actualizar y corregir sus datos, pedir que se borren y retirar esta autorización en cualquier momento, escribiendo a tukit.ayuda@gmail.com. Responsables: Maria Paula Rodríguez Ruiz, Juan Enrique Rozo Tarache, Gabriel Aníbal Riaño Beltrán y Daniel Felipe Castro Moreno, bajo la dirección de el Ing. Julio Ernesto Carreño Vargas. Los datos se guardan con un código y se borran 12 meses después de la aprobación del trabajo de grado. Si autoriza grabar la pantalla o el audio, esas grabaciones se borran cuando verifiquemos el análisis y, a más tardar, a los 30 días.");
  f.addTextItem().setTitle("Código de participante (se lo da la moderadora, por ejemplo ACU-07).").setRequired(true);
  f.addMultipleChoiceItem().setTitle("Parte A. Leí este texto, pude hacer preguntas, soy mayor de 18 años y autorizo de manera libre, previa e informada el uso de mis respuestas con los fines descritos.").setChoiceValues(["Sí, acepto participar", "No acepto"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("Parte B. Autorizo que se grabe la pantalla del celular con la aplicación de prueba mientras hago las tareas (no mi cara ni mi cámara), solo para contar pasos y tiempos. La grabación se borra cuando el análisis esté verificado y, a más tardar, en 30 días.").setChoiceValues(["Sí, autorizo la grabación de pantalla", "No, solo tomen notas"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("Parte C. Autorizo que se grabe el audio de mi voz, solo para transcribir lo que diga durante las tareas, con el mismo plazo de borrado.").setChoiceValues(["Sí, autorizo el audio", "No autorizo el audio"]).setRequired(true);
  f.addTextItem().setTitle("Nombre del acudiente (queda separado de sus respuestas).").setRequired(true);
  f.addPageBreakItem().setTitle("Parte 2. Su última compra de útiles");
  f.addMultipleChoiceItem().setTitle("Usted es: Madre / Padre / Otro acudiente").setChoiceValues(["Madre", "Padre", "Otro acudiente"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("Nivel escolar de su hijo o hija: Preescolar / Primaria / Bachillerato").setChoiceValues(["Preescolar", "Primaria", "Bachillerato"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("¿Cuántos hijos tiene en el colegio? 1 / 2 / 3 o más").setChoiceValues(["1", "2", "3 o más"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("¿Con qué frecuencia compra en línea? Nunca / Alguna vez al año / Cada mes / Cada semana").setChoiceValues(["Nunca", "Alguna vez al año", "Cada mes", "Cada semana"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("La última vez, ¿dónde compró los útiles? Tienda física / En línea / Ambas").setChoiceValues(["Tienda física", "En línea", "Ambas"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("¿Cuánto tiempo le tomó, en total, comprar la lista? Menos de 1 hora / 1 a 2 horas / 2 a 4 horas / Más de 4 horas").setChoiceValues(["Menos de 1 hora", "1 a 2 horas", "2 a 4 horas", "Más de 4 horas"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("¿En cuántos lugares o páginas compró? 1 / 2 / 3 / 4 o más").setChoiceValues(["1", "2", "3", "4 o más"]).setRequired(true);
  f.addSectionHeaderItem().setHelpText("Ahora piense en esa última compra de útiles con su forma habitual de comprar. Califique de 0 (muy bajo) a 10 (muy alto):");
  f.addScaleItem().setTitle("Exigencia mental: ¿cuánto tuvo que pensar, comparar, decidir y recordar?").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Exigencia física: ¿cuánto tuvo que desplazarse, cargar o moverse?").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Presión de tiempo: ¿cuánta prisa o presión sintió?").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Resultado: ¿qué tan mal le fue en conseguir todo lo de la lista? (0 = perfecto, 10 = muy mal)").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Esfuerzo: ¿cuánto se tuvo que esforzar para lograrlo?").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Frustración: ¿qué tan estresado o molesto se sintió?").setBounds(0,10).setRequired(true);
  f.addPageBreakItem().setTitle("Parte 3. La prueba con TUKIT");
  f.addSectionHeaderItem().setHelpText("Ahora piense en la compra que acaba de hacer con TUKIT. Califique de 0 (muy bajo) a 10 (muy alto):");
  f.addScaleItem().setTitle("Exigencia mental").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Exigencia física").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Presión de tiempo").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Resultado (0 = perfecto, 10 = muy mal)").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Esfuerzo").setBounds(0,10).setRequired(true);
  f.addScaleItem().setTitle("Frustración").setBounds(0,10).setRequired(true);
  f.addSectionHeaderItem().setHelpText("En general, cada tarea fue (1 = muy difícil, 7 = muy fácil):");
  f.addScaleItem().setTitle("Crear la cuenta y elegir el colegio y el grado").setBounds(1,7).setRequired(true);
  f.addScaleItem().setTitle("Contar qué le gusta a su hijo y cuánto quiere gastar").setBounds(1,7).setRequired(true);
  f.addScaleItem().setTitle("Elegir uno de los kits").setBounds(1,7).setRequired(true);
  f.addScaleItem().setTitle("Cambiar o quitar un producto del kit").setBounds(1,7).setRequired(true);
  f.addScaleItem().setTitle("Pagar el pedido").setBounds(1,7).setRequired(true);
  f.addScaleItem().setTitle("Encontrar su pedido y ver cómo va").setBounds(1,7).setRequired(true);
  f.addScaleItem().setTitle("Pedirle un cambio al asistente del kit (el chat «¿Cambiamos algo?»). Si no lo usó, déjela en blanco.").setBounds(1,7).setRequired(false);
  f.addScaleItem().setTitle("¿Qué tan seguro está de que el kit que eligió es el adecuado para su hijo? (1 = nada seguro, 7 = muy seguro)").setBounds(1,7).setRequired(true);
  f.addPageBreakItem().setTitle("Parte 4. Su opinión sobre TUKIT");
  f.addSectionHeaderItem().setHelpText("Marque qué tan de acuerdo está con cada frase (1 = totalmente en desacuerdo, 5 = totalmente de acuerdo). Lea cada frase completa: algunas están escritas en positivo y otras en negativo.");
  f.addScaleItem().setTitle("Creo que me gustaría usar TUKIT con frecuencia.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Encontré TUKIT innecesariamente complejo.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Pensé que TUKIT era fácil de usar.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Creo que necesitaría el apoyo de una persona técnica para poder usar TUKIT.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Encontré que las diversas funciones de TUKIT estaban bien integradas.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Pensé que había demasiada inconsistencia en TUKIT.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Imagino que la mayoría de las personas aprendería a usar TUKIT muy rápido.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Encontré TUKIT muy incómodo de usar.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Me sentí muy seguro o segura usando TUKIT.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("Necesité aprender muchas cosas antes de poder empezar a usar TUKIT.").setBounds(1,5).setRequired(true);
  f.addScaleItem().setTitle("¿Qué tan probable es que recomiende TUKIT a otro papá o mamá del colegio? (0 = nada probable, 10 = muy probable)").setBounds(0,10).setRequired(true);
  f.addParagraphTextItem().setTitle("¿Cuál es la razón principal de su respuesta anterior?").setRequired(false);
  f.addParagraphTextItem().setTitle("¿Qué fue lo más confuso de la prueba?").setRequired(false);
  f.addParagraphTextItem().setTitle("¿Qué le cambiaría a TUKIT?").setRequired(false);
  f.addMultipleChoiceItem().setTitle("Si TUKIT existiera hoy, ¿con qué pagaría? Tarjeta de crédito / Tarjeta débito / PSE / Nequi o Daviplata / Efectivo contra entrega").setChoiceValues(["Tarjeta de crédito", "Tarjeta débito", "PSE", "Nequi o Daviplata", "Efectivo contra entrega"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle("¿Pagaría un poco más por recibir el kit armado en su casa? No / Hasta un 5 % más / Hasta un 10 % más / Más del 10 %").setChoiceValues(["No", "Hasta un 5 % más", "Hasta un 10 % más", "Más del 10 %"]).setRequired(true);
  Logger.log("Editar: " + f.getEditUrl());
  Logger.log("Responder: " + f.getPublishedUrl());
}
