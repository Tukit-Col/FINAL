@inproceedings{bayrak_evaluating_2024,
	title = {Evaluating {Generative} {AI}-{Driven} {Bundle} {Creation} for {Recommendation}},
	url = {https://ieeexplore.ieee.org/abstract/document/11037884},
	doi = {10.1109/CEII65291.2024.00050},
	abstract = {Recommender systems have become essential tools for service providers, enabling efficient connections between customers and products in marketplaces where the competition is quite high. As the scale of products and user bases grows, matching the right items with the right users has become critical accordingly. This study evaluates the use of generative AI, specifically ChatGPT, to create and expand product bundles on different datasets. Traditional methods, including the Apriori algorithm and word embedding models, are trained to generate recommendations using existing and AI-generated bundles. The results demonstrate that generative AI tools can effectively enhance bundle generation in specific scenarios when producing basket data. This indicates that tools such as ChatGPT have sianlficant potential to advance recommendation systems.},
	urldate = {2026-03-15},
	booktitle = {2024 7th {Asia} {Conference} on {Cognitive} {Engineering} and {Intelligent} lnteraction ({CEII})},
	author = {Bayrak, Ahmet Tu{\u g}rul},
	month = dec,
	year = {2024},
	keywords = {Accuracy, association rule learning, Chatbots, Companies, Data models, Faces, generative ai, Generative AI, Industries, Limiting, pre-trained transformer, recommendation systems, Recommender systems, Transformers, word embedding},
	pages = {219--222},
	annote = {[6]},
	file = {Full Text PDF:files/414/Bayrak - 2024 - Evaluating Generative AI-Driven Bundle Creation for Recommendation.pdf:application/pdf},
}

@article{blank_pymoo_2020,
	title = {Pymoo: {Multi}-{Objective} {Optimization} in {Python}},
	volume = {8},
	issn = {2169-3536},
	shorttitle = {Pymoo},
	url = {https://ieeexplore.ieee.org/abstract/document/9078759},
	doi = {10.1109/ACCESS.2020.2990567},
	abstract = {Python has become the programming language of choice for research and industry projects related to data science, machine learning, and deep learning. Since optimization is an inherent part of these research fields, more optimization related frameworks have arisen in the past few years. Only a few of them support optimization of multiple conflicting objectives at a time, but do not provide comprehensive tools for a complete multi-objective optimization task. To address this issue, we have developed pymoo, a multi-objective optimization framework in Python. We provide a guide to getting started with our framework by demonstrating the implementation of an exemplary constrained multi-objective optimization scenario. Moreover, we give a high-level overview of the architecture of pymoo to show its capabilities followed by an explanation of each module and its corresponding sub-modules. The implementations in our framework are customizable and algorithms can be modified/extended by supplying custom operators. Moreover, a variety of single, multi- and many-objective test problems are provided and gradients can be retrieved by automatic differentiation out of the box. Also, pymoo addresses practical needs, such as the parallelization of function evaluations, methods to visualize low and high-dimensional spaces, and tools for multi-criteria decision making. For more information about pymoo, readers are encouraged to visit: https://pymoo.org.},
	urldate = {2026-03-15},
	journal = {IEEE Access},
	author = {Blank, Julian and Deb, Kalyanmoy},
	year = {2020},
	keywords = {Customization, Data visualization, Evolutionary computation, genetic algorithm, multi-objective optimization, Optimization, python, Python, Task analysis, Tools},
	pages = {89497--89509},
	annote = {[7]
},
	file = {Full Text PDF:files/417/Blank and Deb - 2020 - Pymoo Multi-Objective Optimization in Python.pdf:application/pdf},
}

