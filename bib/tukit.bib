@misc{noauthor_informe_nodate-1,
	title = {Informe de cierre ecommerce 2025 / {Versi{\'o}n} publica.},
	url = {https://ccce.org.co/noticias/informe-de-cierre-ecommerce-2025-version-publica/},
	abstract = {El comercio electr{\'o}nico contin{\'u}a creciendo durante el 2025. Conozca los detalles en nuestro reciente informe del comportamiento del comercio electr{\'o}nico en Colombia. Destacamos algunos de los principales hallazgos: 

 Durante 2025, el valor nominal de las ventas en l{\'{\i}}nea alcanz{\'o} los COP \$145,4 billones, lo que representa un crecimiento del 11,1\% frente al mismo periodo de 2024.  

El valor real de las ventas en l{\'{\i}}nea alcanz{\'o} los COP \$105,7 billones, lo que representa un crecimiento del 5,9\% frente al mismo periodo de 2024.  

 En cuanto al n{\'u}mero de transacciones, se registraron 684,6 millones de compras en l{\'{\i}}nea durante 2025, un incremento anual del 19,9\% interanual.  

 El ticket nominal promedio se ubic{\'o} en COP \$212.373, lo que implic{\'o} una ca{\'{\i}}da del 7,3 \% frente a 2024. Por su parte, ticket real promedio se totaliz{\'o} en COP \$ 154.370, una ca{\'{\i}}da del 11,6 \% frente a 2024.  

 Las categor{\'{\i}}as l{\'{\i}}deres que concentraron la mayor participaci{\'o}n en valor fueron Tecnolog{\'{\i}}a con el 17,3 \%, Otras de Retail con el 11,8 \% y Transporte con el 10,5\%. En cuando al n{\'u}mero de transacciones, las Entretenimiento lidera la participaci{\'o}n con el 25,7 \%.  

 En medios de pago, en valor de transacciones el d{\'e}bito a cuenta bancaria o PSE alcanz{\'o} una participaci{\'o}n del 57,2\% y en n{\'u}mero el 46,5\%, superando al uso de tarjetas y efectivo.  

 La participaci{\'o}n del comercio electr{\'o}nico dentro del comercio minorista se mantuvo estable torno al 2,4\% en promedio durante 2025. 

Esperamos que estos datos sean un recurso valioso para los diferentes actores del sector y contribuyan a la toma de decisiones informadas. 

Les invitamos a consultar el informe p{\'u}blico, disponible para todos los interesados. {!`}Af{\'{\i}}liate para acceder al informe completo y tener muchos beneficios m{\'a}s!},
	language = {es-CO},
	urldate = {2026-03-15},
	journal = {Camara Colombiana de Comercio Electr{\'o}nico},
	annote = {[16]},
	file = {PDF:files/464/Informe de cierre ecommerce 2025  Versi{\'o}n publica..pdf:application/pdf;Snapshot:files/461/informe-de-cierre-ecommerce-2025-version-publica.html:text/html},
}

