# De donde salen los datos. Es la unica bandera que hay que mover el dia que
# el backend responda.
#
#   simulado  (por defecto) lee datos/catalogo/*.csv y el corpus de listas,
#             a traves de las semillas de libs/ts/tukit-contrato.
#   api       habla con TUKIT_API_URL sobre el prefijo /v1 del CONTRATO_API.
TUKIT_ORIGEN_DATOS=simulado

# Solo se usa con TUKIT_ORIGEN_DATOS=api. Nunca llega al navegador.
TUKIT_API_URL=http://localhost:8080

# --- Solo para el origen simulado -------------------------------------------

# Cuanto tarda el pipeline simulado en recorrer las cuatro etapas. En el
# sistema real son minutos; aqui son segundos para poder mirar la pantalla de
# espera sin cronometro.
TUKIT_SIMULADO_SEGUNDOS=12

# Segundos que el trabajo pasa en `espera_revision` antes de auto-publicarse.
TUKIT_SIMULADO_SEGUNDOS_REVISION=8

# Ponlo en `false` para que el trabajo se quede en `espera_revision` hasta que
# alguien lo apruebe desde apps/admin. Es el comportamiento fiel al contrato:
# publicar es una decision de una persona.
TUKIT_SIMULADO_AUTOAPROBAR=true

# Donde vive el almacen de trabajos simulados, compartido entre web y admin.
# Por defecto, $TMPDIR/tukit-simulado.
# TUKIT_SIMULADO_DIR=/tmp/tukit-simulado
