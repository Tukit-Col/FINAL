# Entorno de la PWA del acudiente (apps/web). Copiar a `.env.local`.
#
# La app siempre habla con el backend real: los 7 microservicios a traves del
# gateway. Ninguna variable lleva el prefijo NEXT_PUBLIC_ a proposito: se leen
# solo desde Server Components y Route Handlers, y el navegador nunca ve la URL.

# El gateway. En local es :8010 (make arriba). Requerida: sin ella la app falla
# de entrada, a proposito (no hay valor por defecto silencioso).
TUKIT_API_URL=http://localhost:8010

# Google Places (New) para sugerir la direccion del checkout (ADR 0044). Opcional:
# sin ella la direccion es texto libre. Es de servidor (sin NEXT_PUBLIC_) y llega
# al navegador solo en el checkout; restringela por referrer y por API (README).
# GOOGLE_MAPS_API_KEY=
