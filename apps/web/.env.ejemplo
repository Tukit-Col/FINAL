# Entorno de la app del acudiente (apps/web). Copiar a `.env.local`.
#
# Ninguna variable lleva el prefijo NEXT_PUBLIC_ a proposito: se leen solo desde
# Server Components y Route Handlers, y el navegador nunca ve la URL del backend.

# El gateway. En local es :8010 (make arriba). Requerida: sin ella la app falla
# de entrada, a proposito (no hay valor por defecto silencioso).
TUKIT_API_URL=http://localhost:8010

# OpenStreetMap (Nominatim) para buscar y fijar en el mapa la direccion del
# checkout. La politica de uso de Nominatim pide un correo de contacto en cada
# consulta. Sin ella /api/direccion/buscar responde 503 y la direccion queda
# como texto libre.
# TUKIT_NOMINATIM_CONTACTO=correo@ejemplo.com
