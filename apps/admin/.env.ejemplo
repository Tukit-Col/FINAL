# Entorno de la consola de revision (apps/admin). Copiar a `.env.local`.
#
# Ninguna variable lleva el prefijo NEXT_PUBLIC_ a proposito: se leen solo desde
# Server Components y Route Handlers, y el navegador nunca ve la URL del backend.

# El gateway. En local es :8010 (make arriba). Requerida: sin ella la app falla
# de entrada, a proposito (no hay valor por defecto silencioso).
TUKIT_API_URL=http://127.0.0.1:8010

# Mapa de entregas: Nominatim exige un contacto real en el User-Agent. Sin esto el mapa queda apagado.
TUKIT_NOMINATIM_CONTACTO=
# Opcional: carpeta del cache de geocodificacion (por omision apps/admin/.cache).
# TUKIT_GEOCACHE_DIR=
