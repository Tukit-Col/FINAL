# Entorno de la consola de revision (apps/admin). Copiar a `.env.local`.
#
# Ninguna de estas variables lleva el prefijo `NEXT_PUBLIC_` a proposito: se
# leen solo desde Server Components y Route Handlers, y el navegador nunca ve
# ni la URL del backend ni la bandera.

# `simulado` (por defecto) lee el corpus del repositorio; `api` habla con
# TUKIT_API_URL sobre /v1.
TUKIT_ORIGEN_DATOS=simulado
TUKIT_API_URL=http://localhost:8080

# Donde vive el almacen simulado. Tiene que ser EL MISMO valor que en
# apps/web: la pausa humana del §7 solo se puede demostrar si el trabajo que
# el acudiente espera es el mismo que el admin aprueba.
# TUKIT_SIMULADO_DIR=/tmp/tukit-simulado

# Cuanto tarda el pipeline simulado en llegar a `espera_revision`.
# TUKIT_SIMULADO_SEGUNDOS=12

# `false` deja el trabajo esperando tu decision en vez de publicarse solo, que
# es el comportamiento fiel al contrato: publicar es una decision de una
# persona. Ojo: el estado lo calcula cada proceso por su cuenta, asi que si
# apps/web no tiene el mismo valor, las dos apps van a discrepar sobre si el
# trabajo ya se publico.
TUKIT_SIMULADO_AUTOAPROBAR=false
