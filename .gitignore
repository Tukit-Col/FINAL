.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# El lock si se versiona; los entornos no.
node_modules/
dist/
build/
*.egg-info/

.env
.env.*
!.env.ejemplo

.DS_Store
*.log

# Artefactos generados del catalogo: se regeneran, no se versionan.
#   catalogo.html          -> make bd-vista (vista.py)
#   cache_tiendas/          -> caché de scraper (tiendas.py); se conserva en
#                              disco para no re-scrapear, pero fuera de git.
#   demanda_atributos.json  -> make bd-demanda (informe)
catalogo.html
datos/catalogo/cache_tiendas/
datos/catalogo/demanda_atributos.json

# Los pid y los registros de los cuatro procesos que levanta `make arriba`.
# Son estado de UNA maquina en UN momento; versionarlos haria que el `make
# abajo` de otra persona intentara matar un proceso que nunca existio.
.ejecucion/

# Worktrees aislados para ejecutar planes sin tocar la copia principal.
.worktrees/

# Next.js lo regenera en cada `next dev` / `next build` (apunta a .next/dev/types o a
# .next/types segun el ultimo comando), asi que versionarlo solo produce ruido.
next-env.d.ts

# Caches de los ensayos (lo que Gemini ya leyo): ensayos/entorno.py, TUKIT_CACHE_ENSAYOS.
.cache/

# Resultados locales de Firecrawl (busquedas y paginas raspadas)
.firecrawl/

# Cache de geocodificacion (Nominatim) del admin.
apps/admin/.cache/

# Cobertura y residuos de editor/SO que no son del proyecto.
.coverage
.coverage.*
htmlcov/
coverage/
test-results/
*.bak
*.orig
*.swp
Thumbs.db

# Configuracion local de Claude Code (la skill de .claude/skills si se versiona).
.claude/settings.local.json
