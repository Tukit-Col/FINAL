# Variables de entorno del backend. Copia a `.env` y ajusta.
#
# Ninguna es obligatoria: los valores por omision levantan el sistema entero
# en una maquina de desarrollo. Estan aqui para que se sepa que existen, que
# es el problema de una configuracion que solo vive en valores por omision:
# nadie sabe que se puede cambiar hasta que hace falta cambiarla.

# --- Base de datos --------------------------------------------------------
# Cada servicio deriva el nombre de SU base del nombre del servicio, en
# `tukit_comun.config`. El nombre nunca se escribe en el codigo de un
# servicio: es lo que mantiene verde la regla 3 del manifiesto.
TUKIT_DB_HOST=localhost
TUKIT_DB_PORT=5432
TUKIT_DB_USER=tukit
TUKIT_DB_PASSWORD=tukit

# Alternativa: la URL completa de UN servicio, que gana sobre las piezas de
# arriba. Es la via de produccion y la de un compose que la inyecta entera.
# TUKIT_CATALOGO_DB_URL=postgresql+asyncpg://tukit:tukit@postgres:5432/tukit_catalogo

# --- Donde esta cada servicio ---------------------------------------------
# Las lee la puerta de enlace para rutear, e `inteligencia` para hablar con
# catalogo e identidad. Dentro de Docker son nombres de servicio.
TUKIT_IDENTIDAD_URL=http://127.0.0.1:8011
TUKIT_CATALOGO_URL=http://127.0.0.1:8012
TUKIT_INTELIGENCIA_URL=http://127.0.0.1:8013

# --- Navegador ------------------------------------------------------------
# Separados con comas. Sin esta variable valen los dos puertos de un Next.js
# recien creado; produccion NO hereda la lista de desarrollo.
# TUKIT_CORS_ORIGENES=https://tukit.co,https://admin.tukit.co

# La base de la app del acudiente. La usa el repartidor para armar el enlace de
# pre-compra del aviso `kits_publicados` (`{web}/kits/{trabajo_id}`); el enlace
# lleva solo el trabajo_id opaco, nunca contacto. Por omision el Next.js local.
# TUKIT_WEB_URL=http://localhost:3000

# --- Pipeline -------------------------------------------------------------
# Confianza por encima de la cual el emparejamiento se da por bueno sin que lo
# mire una persona. Es la tau configurable que pide PE-04.
TUKIT_TAU=0.75

# ATAJO DE DESARROLLO. Con esto en 1, el trabajo pasa de `procesando` a
# `publicado` sin revision humana, y el contrato dice explicitamente que el
# acudiente nunca ve un kit sin revisar (AD-06). Existe para que el frontend
# pueda ver kits mientras se construye la pantalla de Admin. El servicio lo
# anuncia al arrancar. NO debe estar puesto fuera de desarrollo.
# TUKIT_AUTOPUBLICAR=1

# --- Cifrado --------------------------------------------------------------
# Llave Fernet para los datos personales derivados (`kit.pesos_usados`, las
# preferencias del trabajo). Sin ella el puerto usa un adaptador que NO cifra
# y lo dice en cada arranque, que es distinto de no tener cifrado y creer que
# se tiene. Se genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TUKIT_LLAVE_CIFRADO=

# --- Percepcion (todavia no conectada) ------------------------------------
# La entrada por archivo del contrato (seccion 2b) la necesita. Sin ella el
# endpoint solo acepta la entrada por colegio y grado.
# GEMINI_API_KEY=

# --- Pasarela de pago (Wompi) ---------------------------------------------
# falso   -> pasarela simulada, no sale a la red (por omision)
# sandbox -> checkout real de Wompi en modo PRUEBAS. Solo acepta llaves de prueba.
# Las llaves salen de comercios.wompi.co -> Desarrolladores (modo pruebas).
WOMPI_MODO=falso
# WOMPI_LLAVE_PUBLICA=pub_test_...
# WOMPI_LLAVE_PRIVADA=prv_test_...
# WOMPI_SECRETO_EVENTOS=test_events_...
# WOMPI_SECRETO_INTEGRIDAD=test_integrity_...
# --- Backbone (B.2/B.3/B.4). Vacías = apagado, degradación honesta. ---
# Sin estas, todo corre sin broker, sin caché, sin trazas y con logs de texto.
# RabbitMQ lo levanta `make bd-arriba` junto a Postgres; OTLP y Redis,
# `make infra-arriba`.

# Broker de eventos (RabbitMQ, ADR 0046). Con ella, cada productor publica su
# bandeja con un publicador y cada consumidor escucha su cola, sin leer bases
# ajenas. Vacía => los consumidores sondean las bandejas, como antes. El
# Makefile no lee este archivo: `make arriba` usa esta misma URL por omisión y,
# si el broker no responde, levanta todo sin ella.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Collector OTLP para trazas + métricas. Vacía => OTel no-op total.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Redis (ADR 0047): la caché de las lecturas aceptadas de las listas y de los
# vectores de los renglones, y el contador del límite de tasa de la puerta.
# Solo guarda lo que se puede recalcular y contadores que se pueden perder.
# Vacía => sin caché, y el límite cuenta en la memoria de cada puerta. El
# Makefile no lee este archivo: `make arriba` usa esta misma URL por omisión y,
# si Redis no responde, levanta todo sin ella.
REDIS_URL=redis://localhost:6379/0
# Lo que se espera a Redis en cada operación antes de seguir sin él (ms).
# TUKIT_REDIS_ESPERA_MS=250
# Cuánto dura lo guardado (s): la lectura aceptada y el vector. 0 apaga esa caché.
# TUKIT_CACHE_PERCEPCION_SEGUNDOS=2592000
# TUKIT_CACHE_VECTORES_SEGUNDOS=86400
# El límite de tasa: la ventana (s) y los topes por token y por IP de cada
# nivel. El general cuenta todo /v1/*; el estricto, por ruta, las que cuestan
# (subir una lista, crear un trabajo, entrar, registrarse). 0 apaga ese conteo.
# TUKIT_LIMITE_GENERAL_VENTANA=60
# TUKIT_LIMITE_GENERAL_TOKEN=300
# TUKIT_LIMITE_GENERAL_IP=1200
# TUKIT_LIMITE_ESTRICTO_VENTANA=600
# TUKIT_LIMITE_ESTRICTO_TOKEN=30
# TUKIT_LIMITE_ESTRICTO_IP=60
# Los proxies cuya X-Forwarded-For cree la puerta (IP o redes, separadas por
# comas). Por omisión, la propia máquina, que es donde corre la web.
# TUKIT_PROXIES_CONFIANZA=127.0.0.1,::1
# Logs JSON con correlación. Vacía/ausente => formato humano.
TUKIT_LOG_JSON=1
# TTL de reserva antes de que el barredor la libere (minutos).
TUKIT_TTL_RESERVA_MIN=30






